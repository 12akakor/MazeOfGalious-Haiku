/*
 * Application resources for the native Haiku/RenkuOS build.
 * The vector icon is generated by tools/make_icon.py (icon.rdef).
 */

resource app_signature "application/x-vnd.BrainGames-MazeOfGalious";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 63,
	minor  = 1,

	variety = B_APPV_FINAL,
	internal = 1548,

	short_info = "Maze of Galious remake",
	long_info = "Maze of Galious remake 0.63 by Brain Games, native Haiku/RenkuOS port"
};

/* icon.rdef is appended by the Makefile. */
